{
  "name": "devpath-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:connections": "node --env-file-if-exists=.env scripts/check-connections.mjs",
    "check:grading": "node --env-file-if-exists=.env scripts/check-grading.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-database.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "prestart": "npm run build:editor",
    "predev": "npm run build:editor"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.23.1"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
