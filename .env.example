# Copie este arquivo para .env. Nunca publique sua chave Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Opcional: envia o resumo de desempenho à Groq ao preparar novas aulas.
AI_PERSONALIZATION=false
# Project URL e publishable key (ou anon legada), nunca service_role/secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=3000
